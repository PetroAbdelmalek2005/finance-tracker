# Copy this file to .env and fill in your values.
# The anon key is safe to expose in the browser — it is scoped by Row Level Security policies.
# NEVER commit .env to git. NEVER put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
